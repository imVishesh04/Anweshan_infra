# ==============================================================================
# ANWESHAN Infra Backend Configuration
# ==============================================================================

# --- Required Core Settings (App will fail to start if any of these are missing) ---
# MongoDB connection string (Local MongoDB Community or MongoDB Atlas M0 cluster)
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=anweshan_infra

# Secret key for signing JWT tokens (MUST be at least 32 characters long)
# Generate one using: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars_long

# Initial administrator password (only used during initial seeding if no admin user exists)
ADMIN_PASSWORD=change_this_admin_password

# --- Environment & Server ---
# Application environment ('dev' or 'prod'). In 'prod', OpenAPI/Swagger docs are disabled.
ENV=dev

# Allowed CORS origins (comma-separated). No trailing slashes.
CORS_ORIGINS=http://localhost:3000

# Administrator email for login identification and seed
ADMIN_EMAIL=admin@anweshaninfra.com

# Cookie security settings (In dev: false/lax. In prod: true/lax for same-site deployments)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Storage Configuration ---
# Storage backend: 'local' (filesystem, dev-only) or 'r2' (Cloudflare R2, recommended for production)
STORAGE_BACKEND=local

# Local storage directory (used when STORAGE_BACKEND=local)
UPLOAD_DIR=backend/uploads

# Cloudflare R2 Credentials (used when STORAGE_BACKEND=r2)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET=anweshan-media

# --- Owner Lead Notifications (Optional - leaves a clean log if unconfigured) ---
# Telegram Bot alert (Recommended - Free)
# NOTIFY_TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# NOTIFY_TELEGRAM_CHAT_ID=123456789

# Resend Email alert (Optional)
# RESEND_API_KEY=re_123456789
# NOTIFY_EMAIL_TO=owner@anweshaninfra.com

# Twilio WhatsApp alert (Optional)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=+14155238886
# OWNER_WHATSAPP=+918658429239

# Optional: sender address for Resend email alerts (must be a domain you verified in Resend)
# NOTIFY_EMAIL_FROM=ANWESHAN Infra <alerts@anweshaninfra.in>

# Netlify signed proxy secret. Set the SAME value as an environment variable named
# NETLIFY_PROXY_SECRET in Netlify (Site configuration > Environment variables).
# It lets the backend trust the real visitor IP passed on by Netlify.
# NETLIFY_PROXY_SECRET=<a long random string>
