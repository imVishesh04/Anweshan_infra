# ==============================================================================
# ANWESHAN Infra Frontend Configuration
# ==============================================================================

# Backend API base URL.
# Leave EMPTY ("") in development so requests go through the craco devServer proxy (/api -> http://localhost:8001).
# In production on Netlify, leave empty: netlify.toml proxies /api to the backend.
REACT_APP_BACKEND_URL=

# NOTE: Legacy Emergent variables like `WDS_SOCKET_PORT=443` and `ENABLE_HEALTH_CHECK`
# are Emergent platform leftovers and should be removed from your local frontend/.env file.
